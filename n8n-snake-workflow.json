        "html": "=<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 520px; margin: 0 auto; background: linear-gradient(135deg, #0a0e17, #1a2235); border-radius: 16px; overflow: hidden; border: 1px solid rgba(56, 189, 248, 0.2);\">\n  <div style=\"background: linear-gradient(135deg, #22d3ee, #06b6d4); padding: 28px; text-align: center;\">\n    <h1 style=\"margin: 0; font-size: 28px; color: #0a0e17;\">🐍 Snake Game</h1>\n    <p style=\"margin: 4px 0 0; font-size: 14px; color: rgba(10,14,23,0.7);\">¡Se ha batido un nuevo récord!</p>\n  </div>\n  <div style=\"padding: 28px; color: #f1f5f9;\">\n    <div style=\"background: rgba(56, 189, 248, 0.08); border-radius: 12px; padding: 20px; text-align: center; margin-bottom: 20px; border: 1px solid rgba(56, 189, 248, 0.15);\">\n      <p style=\"margin: 0; font-size: 13px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;\">Nueva Puntuación Máxima</p>\n      <p style=\"margin: 8px 0 0; font-size: 48px; font-weight: 800; color: #fbbf24; text-shadow: 0 0 20px rgba(251,191,36,0.4);\">{{ $json.body.score }}</p>\n      <p style=\"margin: 4px 0 0; font-size: 14px; color: #94a3b8;\">puntos</p>\n    </div>\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr>\n        <td style=\"padding: 10px 0; color: #64748b; font-size: 13px;\">👤 Jugador</td>\n        <td style=\"padding: 10px 0; text-align: right; color: #f1f5f9; font-weight: 600;\">{{ $json.body.playerName || 'Anónimo' }}</td>\n      </tr>\n      <tr style=\"border-top: 1px solid rgba(255,255,255,0.06);\">\n        <td style=\"padding: 10px 0; color: #64748b; font-size: 13px;\">📏 Longitud serpiente</td>\n        <td style=\"padding: 10px 0; text-align: right; color: #f1f5f9; font-weight: 600;\">{{ $json.body.snakeLength }} segmentos</td>\n      </tr>\n      <tr style=\"border-top: 1px solid rgba(255,255,255,0.06);\">\n        <td style=\"padding: 10px 0; color: #64748b; font-size: 13px;\">⚡ Velocidad final</td>\n        <td style=\"padding: 10px 0; text-align: right; color: #f1f5f9; font-weight: 600;\">{{ $json.body.finalSpeed }}ms/tick</td>\n      </tr>\n      <tr style=\"border-top: 1px solid rgba(255,255,255,0.06);\">\n        <td style=\"padding: 10px 0; color: #64748b; font-size: 13px;\">🕐 Fecha</td>\n        <td style=\"padding: 10px 0; text-align: right; color: #f1f5f9; font-weight: 600;\">{{ $now.format('dd/MM/yyyy HH:mm') }}</td>\n      </tr>\n    </table>\n  </div>\n  <div style=\"padding: 16px 28px; background: rgba(0,0,0,0.2); text-align: center;\">\n    <p style=\"margin: 0; font-size: 12px; color: #64748b;\">Snake Game — Notificación automática vía n8n</p>\n  </div>\n</div>",
